# ---------------------------------------------------------------------------
# Copia este fichero a .env y rellena los valores. El .env NO va al repositorio.
#
# OJO CON EL SIGNO $: Docker Compose interpreta $ como interpolación de
# variables. Si una contraseña lleva un $, hay que escribirlo DOBLE ($$) o
# se te comerá el resto. Lo más simple es no usar $ en las contraseñas.
# ---------------------------------------------------------------------------

# --- Base de datos ---------------------------------------------------------
DB_NAME=presupuesto
DB_USER=presupuesto
DB_PASS=sxd12iko..
DB_ROOT_PASS=azs12olp..

# --- Publicación -----------------------------------------------------------
# Subdominio con el que lo sirve Caddy.
DOMINIO=cuentas.hestiabuluu.es

# Redes desde las que se permite el acceso, separadas por espacios.
# La primera es la de WireGuard; ajústala a la que use tu wg-easy.
REDES_VPN=10.8.0.0/24

# --- Uso fuera de Docker (desarrollo en local) -----------------------------
# DB_HOST=localhost
# DB_PORT=3306
# HOST=127.0.0.1
# PUERTO=3000
