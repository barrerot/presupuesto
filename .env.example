# ---------------------------------------------------------------------------
# Copia a .env y rellena. El .env NO va al repositorio.
#
# OJO CON EL SIGNO $: Docker Compose lo interpreta como interpolación de
# variables. Si una contraseña lleva $, hay que escribirlo DOBLE ($$).
# Lo más simple es no usar $ en las contraseñas.
# ---------------------------------------------------------------------------

DB_NAME=presupuesto
DB_USER=presupuesto
DB_PASS=sxd12iko..
DB_ROOT_PASS=azs12olp..

# --- Solo en el VPS --------------------------------------------------------
# Puerto del host al que se ata la app. El 3000 lo ocupa Miplan.
PUERTO_HOST=3001

